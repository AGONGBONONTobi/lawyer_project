# Supabase — back office des domaines d'expertise.
#
# Sans ces deux variables le site fonctionne normalement, avec les trois
# domaines livrés par défaut ; seul /admin devient indisponible.
#
# La clé anon est publique par nature (elle part dans le bundle). Ce qui protège
# les données, ce sont les politiques RLS de supabase/domaines_schema.sql.
# Ne jamais mettre la clé `service_role` ici.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
